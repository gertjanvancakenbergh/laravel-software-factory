#!/usr/bin/env bash
# Laravel Software Factory entrypoint
# Usage:
#   factory mode                 # show current mode
#   factory mode auto|manual     # switch mode
#   factory run                  # auto: list labeled issues and print next action
#   factory run <issue-number>   # auto: prepare a job for a specific issue
#   factory grill                # manual: remind to start Grill
#   factory status               # list current jobs

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
CONFIG="$ROOT/factory/config.json"
JOB="$ROOT/factory/bin/job"

mode() {
  if [ $# -eq 0 ]; then
    jq -r '.mode' "$CONFIG"
  else
    jq --arg m "$1" '.mode = $m' "$CONFIG" > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"
    echo "Mode set to $1"
  fi
}

case "${1:-}" in
  mode)
    shift
    mode "$@"
    ;;
  run)
    CURRENT=$(mode)
    if [ "$CURRENT" != "auto" ]; then
      echo "Auto mode is not active. Run: factory mode auto"
      exit 1
    fi
    ISSUE="${2:-}"
    if [ -n "$ISSUE" ]; then
      echo "Preparing job for issue #$ISSUE"
      "$JOB" create "$ISSUE" "Issue #$ISSUE" || true
      "$JOB" show "$ISSUE"
      echo ""
      echo "Next: hand this to the Orchestrator with the issue body."
      echo "Pipeline: Intake → Spec → Tickets → Implement → Gate → Review → Approver"
      echo "Gate: $ROOT/factory/checks.sh"
    else
      echo "Auto mode ready."
      echo "Label issues with 'factory' then run: factory run <issue-number>"
      echo "Or give a prompt directly to the Orchestrator."
      echo "Current jobs:"
      "$JOB" list
    fi
    ;;
  grill)
    CURRENT=$(mode)
    if [ "$CURRENT" != "manual" ]; then
      echo "Manual mode is not active. Run: factory mode manual"
      exit 1
    fi
    echo "Manual mode: start the Grill agent (agents/grill.md)."
    echo "Grill will ask questions and require explicit permission before Spec or implementation."
    ;;
  status)
    "$JOB" list
    ;;
  *)
    echo "Usage: factory {mode|run|grill|status}"
    exit 1
    ;;
esac
